# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql://bankdoc:bankdoc_dev_pw@localhost:5432/bankdoc

# Embedding model (runs locally on CPU/GPU, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM provider: "ollama" (local, free), "openai" or "anthropic"
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Retrieval (see docs/adr for how these values were chosen)
TOP_K=8
MIN_SCORE=0.65
